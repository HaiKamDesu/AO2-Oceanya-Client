<UserControl x:Class="OceanyaClient.Components.ImageComboBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OceanyaClient.Components"
             xmlns:converters="clr-namespace:OceanyaClient.Converters"
             mc:Ignorable="d" Height="21" Width="195">
    <!-- Add the converter inside the UserControl.Resources -->
    
    
    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <ComboBox x:Name="cboINISelect"
              IsEditable="True"
              TextSearch.TextPath="Name"
              StaysOpenOnEdit="True"
              IsTextSearchEnabled="False"
              VirtualizingPanel.IsVirtualizing="True"
              VirtualizingPanel.VirtualizationMode="Recycling"
              VirtualizingPanel.ScrollUnit="Item"
              ScrollViewer.CanContentScroll="True"
              KeyDown="cboINISelect_KeyDown"
              SelectionChanged="cboINISelect_SelectionChanged"
              PreviewKeyDown="cboINISelect_PreviewKeyDown"
              LostFocus="cboINISelect_LostFocus"
              BorderBrush="Black"
              BorderThickness="1"
              VerticalContentAlignment="Center"
              Background="DarkGray">

            <!-- Move the Converter here so it's available inside the Template -->
            <ComboBox.Resources>
                <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
                <converters:WidthAdjustConverter x:Key="WidthAdjustConverter"/>
            </ComboBox.Resources>

            <!-- Custom ComboBox Template -->
            <ComboBox.Template>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- Border around ComboBox -->
                        <!--
                            Thickness is template-bound, not hardcoded: a theme that asks for a 1px frame
                            (or none) has to be able to get exactly that, and SnapsToDevicePixels keeps it a
                            crisp single pixel instead of an antialiased line that reads as two.
                        -->
                        <Border x:Name="Border"
                    CornerRadius="3"
                    SnapsToDevicePixels="True"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid x:Name="grdBorder">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="columnIcon" Width="Auto"/>
                                    <!-- Icon Column -->
                                    <ColumnDefinition Width="*" />
                                    <!-- Editable Text Column -->
                                    <ColumnDefinition x:Name="columnDropdown" Width="30"/>
                                    <!-- Dropdown button; width is themeable through ArrowWidth -->
                                </Grid.ColumnDefinitions>

                                <!-- Selected Item Image -->
                                <!-- No fixed size or padding: the icon fills the row height so a themed
                                     dropdown's artwork is not boxed inside dead space. -->
                                <Image x:Name="imgSelected" Source="{Binding SelectedItem.ImagePath, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                           Visibility="{Binding SelectedItem.ImagePath, Converter={StaticResource NullToVisibilityConverter}}"
                           Stretch="Uniform"
                           Grid.Column="0"/>

                                <!-- Editable TextBox inside ComboBox -->
                                <TextBox x:Name="PART_EditableTextBox"
                                        Grid.Column="1"
                                        Background="{TemplateBinding Background}" 
                                        Foreground="Black"
                                        BorderThickness="0"
                                        VerticalContentAlignment="Center"
                                        MaxWidth="{Binding ActualWidth, ElementName=Border, Converter={StaticResource WidthAdjustConverter}}"
                                        TextWrapping="NoWrap"
                                        PreviewMouseDown="EditableTextBox_PreviewMouseDown"
                                        PreviewGotKeyboardFocus="EditableTextBox_PreviewGotKeyboardFocus"/>

                                <!-- Dropdown Button (Fixed Width) -->
                                <Border x:Name="Test" Grid.Column="2"
                                    CornerRadius="3,2,2,3"
                                    BorderThickness="1" BorderBrush="#FF7D7D7D">
                                    <!--
                                        Its own template: the stock ToggleButton chrome painted a solid
                                        square over the arrow while the popup was open, which AO2 never does.
                                    -->
                                    <ToggleButton x:Name="btnDropdown" Grid.Column="2"
                                  BorderBrush="{x:Null}"
                                  ClickMode="Press"
                                  Background="DarkGray"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                        <!--
                                            The glyph takes the dropdown's own text colour, the way Qt's
                                            arrow does: a theme writing `QComboBox { color: white }` (AOHD)
                                            gets a white arrow, and ours stays black by default.
                                        -->
                                        <Path x:Name="DropdownGlyph"
                              Width="10" Height="6"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                              Data="M 0 0 L 10 0 L 5 6 Z"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"/>
                                    </ToggleButton>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Dropdown Popup -->
                        <Popup x:Name="Popup"
                   Placement="Bottom"
                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                   StaysOpen="False">
                            <Border Background="White" BorderBrush="Black" BorderThickness="1"
                        Width="{Binding ActualWidth, ElementName=cboINISelect}">
                                <ScrollViewer MaxHeight="150"
                                              CanContentScroll="True"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </ComboBox.Template>


            <!--
                Item Template. The icon size and the row padding follow the control, so a dropdown a theme
                made small still shows readable rows instead of mostly empty space.
            -->
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding ImagePath}"
                               Width="{Binding RowIconSize, RelativeSource={RelativeSource AncestorType=local:ImageComboBox}}"
                               Height="{Binding RowIconSize, RelativeSource={RelativeSource AncestorType=local:ImageComboBox}}"
                               Margin="{Binding RowIconMargin, RelativeSource={RelativeSource AncestorType=local:ImageComboBox}}"
                               Visibility="{Binding ImagePath, Converter={StaticResource NullToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding Name}"
                                   VerticalAlignment="Center"
                                   FontSize="{Binding RowFontSize, RelativeSource={RelativeSource AncestorType=local:ImageComboBox}}"/>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>

            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>
    </Grid>
</UserControl>
