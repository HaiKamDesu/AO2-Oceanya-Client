<UserControl x:Class="OceanyaClient.Components.Panels.DreddFeatureRowPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ModernButton" TargetType="{x:Type Button}">
                    <Setter Property="Background" Value="#FF262626"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#444444"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Padding" Value="12,5"/>
                    <Setter Property="Height" Value="30"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border x:Name="ButtonBorder" 
                                        Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="3">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF3D3D3D" TargetName="ButtonBorder"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#FF171717" TargetName="ButtonBorder"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
        <Style x:Key="DreddRowButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ModernButton}">
                    <Setter Property="Height" Value="22"/>
                    <Setter Property="FontSize" Value="10"/>
                    <Setter Property="Padding" Value="8,2"/>
                    <Setter Property="Background" Value="#FF1F1F1F"/>
                    <Setter Property="BorderBrush" Value="#FF4A4A4A"/>
                </Style>
        <Style x:Key="DreddRowCheckBoxStyle" TargetType="{x:Type CheckBox}">
                    <Setter Property="Foreground" Value="#FFE5E5E5"/>
                    <Setter Property="FontFamily" Value="Arial"/>
                    <Setter Property="FontSize" Value="10"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>
        <Style x:Key="DreddRowListItemStyle" TargetType="{x:Type ListBoxItem}">
                    <Setter Property="Foreground" Value="#FFE8E8E8"/>
                    <Setter Property="Background" Value="#FF1E1E1E"/>
                    <Setter Property="Padding" Value="6,3"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FF2D3C4A"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#FF36506A"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
    </UserControl.Resources>
    <Grid Background="#FF1B1C1F">
        <Canvas x:Name="RowCanvas">
            <TextBlock x:Name="DreddFeatureLabel"
                               Text="Dredd's Background&#x0a;Overlay Override"
                               Canvas.Left="8"
                               Canvas.Top="3"
                               Width="108"
                               TextWrapping="Wrap"
                               ToolTip="Dredd's Background Overlay Override"
                               Foreground="#FFE8E8E8"
                               FontSize="8.5"
                               VerticalAlignment="Center"
                              />
                    <Grid x:Name="DreddOverlaySelector"
                          Canvas.Left="120"
                          Canvas.Top="4"
                          Width="170"
                          Height="22"
                         >
                        <Border Background="#FF1E1E1E" BorderBrush="#FF4A4A4A" BorderThickness="1" CornerRadius="2"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DreddOverlaySelectedText"
                                       Grid.Column="0"
                                       Margin="6,0,2,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="#FFE8E8E8"
                                       FontSize="10"/>
                            <Button x:Name="DreddOverlayDropButton"
                                    Grid.Column="1"
                                    Background="#00000000"
                                    BorderThickness="0"
                                    Foreground="#FFE8E8E8"
                                    FontSize="10"
                                    Content="▼"
                                    Click="DreddOverlayDropButton_Click"/>
                        </Grid>
                    </Grid>
                    <Popup x:Name="DreddOverlayPopup"
                           PlacementTarget="{Binding ElementName=DreddOverlaySelector}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Width="260" MaxHeight="220" Background="#FF1E1E1E" BorderBrush="#FF4A4A4A" BorderThickness="1" CornerRadius="2">
                            <ListBox x:Name="DreddOverlayListBox"
                                     Background="#FF1E1E1E"
                                     BorderThickness="0"
                                     Foreground="#FFE8E8E8"
                                     FontSize="10"
                                     SelectionChanged="DreddOverlayListBox_SelectionChanged"
                                     ItemContainerStyle="{StaticResource DreddRowListItemStyle}"/>
                        </Border>
                    </Popup>
                    <CheckBox x:Name="DreddStickyOverlayCheckBox"
                              Content="Sticky overlay"
                              Canvas.Left="294"
                              Canvas.Top="6"
                              Style="{StaticResource DreddRowCheckBoxStyle}"
                              Checked="DreddStickyOverlayCheckBox_Checked"
                              Unchecked="DreddStickyOverlayCheckBox_Checked"
                             />
                    <Button x:Name="DreddOverlayConfigButton"
                            Content="Config"
                            Canvas.Left="376"
                            Canvas.Top="4"
                            Width="40"
                            Height="22"
                            Style="{StaticResource DreddRowButtonStyle}"
                            Click="DreddOverlayConfigButton_Click"
                           />
                    <Button x:Name="DreddViewChangesButton"
                            Content="View Changes"
                            Canvas.Left="418"
                            Canvas.Top="4"
                            Width="87"
                            Height="22"
                            Style="{StaticResource DreddRowButtonStyle}"
                            Click="DreddViewChangesButton_Click"
                           />
        </Canvas>
    </Grid>
</UserControl>
