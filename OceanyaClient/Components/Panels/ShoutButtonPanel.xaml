<UserControl x:Class="OceanyaClient.Components.Panels.ShoutButtonPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="PanelRoot">
    <ToggleButton x:Name="ShoutToggle"
                  BorderBrush="{x:Null}"
                  Background="{x:Null}"
                  Padding="0"
                  Focusable="False"
                  IsTabStop="False"
                  Checked="ShoutToggle_Changed"
                  Unchecked="ShoutToggle_Changed">
        <ToggleButton.Style>
            <Style TargetType="{x:Type ToggleButton}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Grid>
                                <Image x:Name="ButtonImage"
                                       Stretch="Fill"
                                       Source="{Binding UncheckedImage, ElementName=PanelRoot}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="ButtonImage"
                                            Property="Source"
                                            Value="{Binding CheckedImage, ElementName=PanelRoot}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ToggleButton.Style>
    </ToggleButton>
</UserControl>
