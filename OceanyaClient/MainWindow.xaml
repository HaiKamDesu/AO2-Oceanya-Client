<local:OceanyaWindowContentControl x:Class="OceanyaClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OceanyaClient"
        xmlns:components="clr-namespace:OceanyaClient.Components"
        xmlns:panels="clr-namespace:OceanyaClient.Components.Panels"
        Height="652" Width="510"
        Background="Transparent">

    <!-- 
      1) Copy over any resources from your InitialConfigurationWindow that 
         define the close button style, text styles, animations, etc.
      2) You can omit or customize these if you do not need them for MainWindow.
    -->
    <local:OceanyaWindowContentControl.Resources>
        <!--
            Face-art button: the template holds an Image so a theme's artwork can replace the face, with the
            caption shown on top of it while there is no art. Every themeable extra button uses this, because
            a default WPF Button template has nothing an image override can paint.
        -->
        <Style x:Key="ThemeableFaceButton" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="#FFE8E8E8"/>
            <Setter Property="Background" Value="#FF2A2E33"/>
            <Setter Property="BorderBrush" Value="#FF3E5362"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"/>
                            <Image x:Name="ButtonImage" Stretch="Fill"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonImage" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonImage" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button style with a dark overlay on hover and press -->
        <Style x:Key="ModernButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#FF262626"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF3D3D3D" TargetName="ButtonBorder"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF171717" TargetName="ButtonBorder"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Optional fade-in/out storyboards if you like:
             (Only needed if you want the same fade effect as in InitialConfigurationWindow) -->
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>
        <Storyboard x:Key="FadeOut">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.3"/>
        </Storyboard>




        <Style x:Key="CompactIconButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#FF181C20"/>
            <Setter Property="BorderBrush" Value="#FF3E5362"/>
        </Style>

        <Style x:Key="PopupCommandButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="#FF20262B"/>
            <Setter Property="BorderBrush" Value="#FF4A5963"/>
        </Style>

        <Style x:Key="DarkPopupListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Foreground" Value="#FFE8E8E8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#222F4553"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#334D6A7A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkPopupCheckBoxStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="#FFE6E6E6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </local:OceanyaWindowContentControl.Resources>

    <!-- Optional fade-in trigger (remove if not desired) -->
    <local:OceanyaWindowContentControl.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeIn}"/>
        </EventTrigger>
    </local:OceanyaWindowContentControl.Triggers>

    <local:OceanyaWindowContentControl.Opacity>1</local:OceanyaWindowContentControl.Opacity>

    <!-- Outer border for the "rounded corners + black outline" look -->
    <Border BorderBrush="#222222" BorderThickness="1" CornerRadius="5">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="24"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <panels:ConnectionInfoPanel x:Name="ConnectionInfoBar"
                                        Grid.Row="0"
                                        SizeChanged="ConnectionInfoBar_SizeChanged"/>

            <!-- Optional body background treatment. -->
                <Rectangle x:Name="imgScienceBlur" 
                       Grid.Row="1"
                       HorizontalAlignment="Center" Width="527" Height="670" 
                       VerticalAlignment="Top" Margin="0">
                <Rectangle.Fill>
                    <ImageBrush ImageSource="pack://application:,,,/OceanyaClient;component/Resources/scoienceblur.jpg" Opacity="0.5"/>
                </Rectangle.Fill>
            </Rectangle>

            <Rectangle x:Name="imgScienceBlur_darken"
                       Grid.Row="1"
                       HorizontalAlignment="Center" Width="527" Height="670" 
                       VerticalAlignment="Top" Margin="0" Fill="#7F000000"/>

                <Rectangle HorizontalAlignment="Center" Width="369" Height="276"
                       Grid.Row="1"
                       VerticalAlignment="Top" Margin="0,-21,0,0">
                <Rectangle.Fill>
                    <ImageBrush ImageSource="pack://application:,,,/OceanyaClient;component/Resources/Logo_O.png" Stretch="Uniform" Opacity="0.1"/>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Main body content only; shared window chrome comes from GenericOceanyaWindow. -->
            <Canvas x:Name="MainCanvas" Grid.Row="1" Margin="0" Background="#FF585858">
                <!-- Entire original body content lives here. -->


                <!-- Placement for panel elements comes from OceanyaPanelCatalog (see ApplyPanelCatalogPlacements). -->
                <panels:OocLogPanel x:Name="OocLog"/>

                <Rectangle x:Name="OocDivider" Fill="#FF4E5056" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                <panels:IcLogPanel x:Name="IcLog"/>

                <Image x:Name="imgShoutModifierBG" Source="pack://application:,,,/OceanyaClient;component/Resources/ObjectionButtonsBG.png" Stretch="Fill"/>
                <panels:ShoutButtonPanel x:Name="ShoutHoldIt"
                                         UncheckedImage="pack://application:,,,/OceanyaClient;component/Resources/Buttons/Hold It.png"
                                         CheckedImage="pack://application:,,,/OceanyaClient;component/Resources/Buttons/Hold It_Selected.png"/>
                <panels:ShoutButtonPanel x:Name="ShoutObjection"
                                         UncheckedImage="pack://application:,,,/OceanyaClient;component/Resources/Buttons/Objection.png"
                                         CheckedImage="pack://application:,,,/OceanyaClient;component/Resources/Buttons/Objection_Selected.png"/>
                <panels:ShoutButtonPanel x:Name="ShoutTakeThat"
                                         UncheckedImage="pack://application:,,,/OceanyaClient;component/Resources/Buttons/Take That.png"
                                         CheckedImage="pack://application:,,,/OceanyaClient;component/Resources/Buttons/Take That_Selected.png"/>
                <panels:ShoutButtonPanel x:Name="ShoutCustom"
                                         UncheckedImage="pack://application:,,,/OceanyaClient;component/Resources/Buttons/Custom.png"
                                         CheckedImage="pack://application:,,,/OceanyaClient;component/Resources/Buttons/Custom_Selected.png"/>

                <panels:ClientsListPanel x:Name="ClientsList"/>




                <components:ICMessageSettings x:Name="ICMessageSettingsControl"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <panels:DreddFeatureRowPanel x:Name="DreddFeatureRow" Visibility="Collapsed"/>

                <ContentControl x:Name="ViewportPanelHost"
                                AutomationProperties.AutomationId="Main.Viewport.Panel"
                                Visibility="Collapsed"
                                ClipToBounds="True"/>

                <!-- Hosts for the area and music lists when they render in the window instead of a popup.
                     The popup content is REPARENTED into these, so every handler keeps working. -->
                <ContentControl x:Name="AreaListPanelHost"
                                AutomationProperties.AutomationId="Main.AreaNavigator.Panel"
                                Visibility="Collapsed"
                                ClipToBounds="True"/>

                <ContentControl x:Name="MusicListPanelHost"
                                AutomationProperties.AutomationId="Main.MusicList.Panel"
                                Visibility="Collapsed"
                                ClipToBounds="True"/>

                <Button x:Name="btnAreaMusicSwitch"
                        AutomationProperties.AutomationId="Main.AreaMusic.Switch"
                        AutomationProperties.Name="Switch between area and music lists"
                        Content="A/M"
                        Style="{StaticResource ThemeableFaceButton}"
                        ToolTip="Switch between the area list and the music list"
                        Click="btnAreaMusicSwitch_Click"/>

                <!--
                    Optional AO2 counterparts. All are hidden by default (OceanyaPanelCatalog's
                    hidden-by-default set) and appear when a theme places them or a user un-hides them.
                -->
                <Button x:Name="btnMute"
                        AutomationProperties.AutomationId="Main.Mute"
                        AutomationProperties.Name="Mute"
                        Content="Mute"
                        Style="{StaticResource ThemeableFaceButton}"
                        ToolTip="Mute a player in this area"
                        Click="btnMute_Click"/>

                <Button x:Name="btnEvidence"
                        AutomationProperties.AutomationId="Main.Evidence"
                        AutomationProperties.Name="Evidence"
                        Content="Evidence"
                        Style="{StaticResource ThemeableFaceButton}"
                        ToolTip="Evidence"
                        Click="btnEvidence_Click"/>

                <Button x:Name="btnReloadTheme"
                        AutomationProperties.AutomationId="Main.ReloadTheme"
                        AutomationProperties.Name="Reload theme"
                        Content="Reload"
                        Style="{StaticResource ThemeableFaceButton}"
                        ToolTip="Reload the selected theme"
                        Click="btnReloadTheme_Click"/>

                <Button x:Name="btnChangeCharacter"
                        AutomationProperties.AutomationId="Main.ChangeCharacter"
                        AutomationProperties.Name="Change character"
                        Content="Character"
                        Style="{StaticResource ThemeableFaceButton}"
                        ToolTip="Pick the INIPuppet for this client"
                        Click="btnChangeCharacter_Click"/>

                <Button x:Name="btnCallMod"
                        AutomationProperties.AutomationId="Main.CallMod"
                        AutomationProperties.Name="Call moderator"
                        Content="Call Mod"
                        Style="{StaticResource ThemeableFaceButton}"
                        ToolTip="Call moderator support for this area"
                        Click="btnCallMod_Click"/>

                <!--
                    AO2's `*_remove` buttons: a small X beside a dropdown, shown only while that dropdown is
                    off its default, which resets it when clicked.
                -->
                <Button x:Name="btnResetPosition"
                        AutomationProperties.AutomationId="Main.Ic.ResetPosition"
                        AutomationProperties.Name="Reset position"
                        Content="X"
                        Style="{StaticResource ThemeableFaceButton}"
                        ToolTip="Reset the position to this character's default"
                        Click="btnResetPosition_Click"/>
                <Button x:Name="btnResetCharacter"
                        AutomationProperties.AutomationId="Main.Ic.ResetCharacter"
                        AutomationProperties.Name="Reset character"
                        Content="X"
                        Style="{StaticResource ThemeableFaceButton}"
                        ToolTip="Go back to this client's own character"
                        Click="btnResetCharacter_Click"/>
                <Button x:Name="btnResetSfx"
                        AutomationProperties.AutomationId="Main.Ic.ResetSfx"
                        AutomationProperties.Name="Reset sound effect"
                        Content="X"
                        Style="{StaticResource ThemeableFaceButton}"
                        ToolTip="Reset the sound effect to Default"
                        Click="btnResetSfx_Click"/>

                <!--
                    AO2's `music_search`: one search box beside the A/M switch that filters whichever list is
                    showing. When it is on screen and the music list renders in the window, the list's own
                    search box steps aside so the rows get that space back.
                -->
                <Grid x:Name="AreaMusicSearchPanel">
                    <TextBox x:Name="txtAreaMusicSearch"
                             AutomationProperties.AutomationId="Main.AreaMusic.Search"
                             AutomationProperties.Name="Search areas and music"
                             Background="#FF1C2227"
                             BorderBrush="#FF3E5362"
                             Foreground="#FFE8E8E8"
                             Padding="4,1"
                             VerticalContentAlignment="Center"
                             ToolTip="Search the list"
                             TextChanged="txtAreaMusicSearch_TextChanged"/>
                    <!-- Placeholder, same pattern as the IC and OOC boxes. -->
                    <TextBlock x:Name="txtAreaMusicSearch_Placeholder"
                               Text="Search"
                               Foreground="Gray"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="6,0,0,0"
                               IsHitTestVisible="False"/>
                </Grid>

                <CheckBox x:Name="chkSendShowname"
                          AutomationProperties.AutomationId="Main.Ic.SendShowname"
                          AutomationProperties.Name="Send showname"
                          Content="Showname"
                          Foreground="White"
                          IsChecked="True"
                          Checked="chkSendShowname_Changed"
                          Unchecked="chkSendShowname_Changed"/>

                <!--
                    Judge controls. The bars are pure artwork driven by the server's HP packets, and the
                    four buttons ask the server to play a courtroom animation for everyone.
                -->
                <Image x:Name="imgDefenceBar" Stretch="Fill"/>
                <Image x:Name="imgProsecutionBar" Stretch="Fill"/>

                <Button x:Name="btnDefenceMinus"
                        AutomationProperties.AutomationId="Main.Judge.DefenceMinus"
                        Content="-"
                        Style="{StaticResource ThemeableFaceButton}"
                        ToolTip="Lower the defence health bar"
                        Click="btnDefenceMinus_Click"/>
                <Button x:Name="btnDefencePlus"
                        AutomationProperties.AutomationId="Main.Judge.DefencePlus"
                        Content="+"
                        Style="{StaticResource ThemeableFaceButton}"
                        ToolTip="Raise the defence health bar"
                        Click="btnDefencePlus_Click"/>
                <Button x:Name="btnProsecutionMinus"
                        AutomationProperties.AutomationId="Main.Judge.ProsecutionMinus"
                        Content="-"
                        Style="{StaticResource ThemeableFaceButton}"
                        ToolTip="Lower the prosecution health bar"
                        Click="btnProsecutionMinus_Click"/>
                <Button x:Name="btnProsecutionPlus"
                        AutomationProperties.AutomationId="Main.Judge.ProsecutionPlus"
                        Content="+"
                        Style="{StaticResource ThemeableFaceButton}"
                        ToolTip="Raise the prosecution health bar"
                        Click="btnProsecutionPlus_Click"/>

                <Button x:Name="btnWitnessTestimony"
                        AutomationProperties.AutomationId="Main.Judge.WitnessTestimony"
                        Content="WT"
                        Style="{StaticResource ThemeableFaceButton}"
                        ToolTip="Play the Witness Testimony animation"
                        Click="btnWitnessTestimony_Click"/>
                <Button x:Name="btnCrossExamination"
                        AutomationProperties.AutomationId="Main.Judge.CrossExamination"
                        Content="CE"
                        Style="{StaticResource ThemeableFaceButton}"
                        ToolTip="Play the Cross Examination animation"
                        Click="btnCrossExamination_Click"/>
                <Button x:Name="btnNotGuilty"
                        AutomationProperties.AutomationId="Main.Judge.NotGuilty"
                        Content="Not Guilty"
                        Style="{StaticResource ThemeableFaceButton}"
                        ToolTip="Play the Not Guilty verdict"
                        Click="btnNotGuilty_Click"/>
                <Button x:Name="btnGuilty"
                        AutomationProperties.AutomationId="Main.Judge.Guilty"
                        Content="Guilty"
                        Style="{StaticResource ThemeableFaceButton}"
                        ToolTip="Play the Guilty verdict"
                        Click="btnGuilty_Click"/>

                <!-- Decorative label art beside the sliders; AO2 themes draw the words as one image. -->
                <Image x:Name="imgMusicVolumeLabel" Stretch="Fill"/>
                <Image x:Name="imgSfxVolumeLabel" Stretch="Fill"/>
                <Image x:Name="imgBlipVolumeLabel" Stretch="Fill"/>

                <Slider x:Name="sliderMusicVolume"
                        AutomationProperties.AutomationId="Main.Volume.Music"
                        AutomationProperties.Name="Music volume"
                        Minimum="0"
                        Maximum="100"
                        ToolTip="Music volume"
                        Foreground="#FFE8E8E8"
                        Background="#FF2A2E33"
                        ValueChanged="VolumeSlider_ValueChanged"
                        Thumb.DragCompleted="VolumeSlider_DragCompleted"
                        MouseLeftButtonUp="VolumeSlider_MouseLeftButtonUp"/>

                <Slider x:Name="sliderSfxVolume"
                        AutomationProperties.AutomationId="Main.Volume.Sfx"
                        AutomationProperties.Name="SFX volume"
                        Minimum="0"
                        Maximum="100"
                        ToolTip="Sound effect volume"
                        Foreground="#FFE8E8E8"
                        Background="#FF2A2E33"
                        ValueChanged="VolumeSlider_ValueChanged"
                        Thumb.DragCompleted="VolumeSlider_DragCompleted"
                        MouseLeftButtonUp="VolumeSlider_MouseLeftButtonUp"/>

                <Slider x:Name="sliderBlipVolume"
                        AutomationProperties.AutomationId="Main.Volume.Blip"
                        AutomationProperties.Name="Blip volume"
                        Minimum="0"
                        Maximum="100"
                        ToolTip="Blip volume"
                        Foreground="#FFE8E8E8"
                        Background="#FF2A2E33"
                        ValueChanged="VolumeSlider_ValueChanged"
                        Thumb.DragCompleted="VolumeSlider_DragCompleted"
                        MouseLeftButtonUp="VolumeSlider_MouseLeftButtonUp"/>

                <panels:BottomStatusBarPanel x:Name="BottomBar"/>

                <Popup x:Name="AreaNavigatorPopup"
                       AutomationProperties.AutomationId="Main.AreaNavigator.Popup"
                       Placement="Top"
                       StaysOpen="False"
                       AllowsTransparency="True">
                    <Border x:Name="AreaNavigatorPopupFrame"
                            Background="#FF202020"
                            BorderBrush="#FF3E5362"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10">
                        <Grid x:Name="AreaNavigatorPopupSurface"
                              MinWidth="220"
                              MinHeight="220"
                              Width="282"
                              Height="296">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.RowSpan="4" Background="#E6111418"/>
                            <TextBlock x:Name="txtAreaNavigatorTitle" Text="Area Navigator" Foreground="White" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="txtCurrentArea"
                                       Grid.Row="1"
                                       AutomationProperties.AutomationId="Main.AreaNavigator.CurrentArea"
                                       Text="Current: Unknown"
                                       Foreground="#FFD5E6F0"
                                       Margin="0,0,0,6"/>
                            <ListBox x:Name="lstAreas"
                                     Grid.Row="2"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     AutomationProperties.AutomationId="Main.AreaNavigator.List"
                                     Margin="0,0,0,6"
                                     Background="#FF11161A"
                                     BorderBrush="#FF2F434E"
                                     Foreground="#FFE8E8E8"
                                     ItemContainerStyle="{StaticResource DarkPopupListBoxItemStyle}"
                                     MouseDoubleClick="lstAreas_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,4"
                                                Padding="6,4"
                                                CornerRadius="2"
                                                Background="{Binding RowBackground}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="Bold"
                                                           Foreground="#FFF2F2F2"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding StatusAndCmLine}"
                                                           Margin="0,2,0,0"
                                                           Foreground="#FFE8E8E8"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding PlayersAndLockLine}"
                                                           Margin="0,1,0,0"
                                                           Foreground="#FFE8E8E8"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel x:Name="AreaNavigatorCommandRow" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="btnGoToArea"
                                        AutomationProperties.AutomationId="Main.AreaNavigator.Go"
                                        Content="Go"
                                        Style="{StaticResource PopupCommandButtonStyle}"
                                        Click="btnGoToArea_Click"/>
                            </StackPanel>
                            <Thumb Grid.RowSpan="4"
                                   Width="5"
                                   HorizontalAlignment="Right"
                                   Cursor="SizeWE"
                                   Background="Transparent"
                                   Opacity="0"
                                   Margin="0,-10,-10,-10"
                                   DragDelta="AreaNavigatorRightResizeThumb_DragDelta"
                                   DragCompleted="PopupResizeThumb_DragCompleted"/>
                            <Thumb Grid.RowSpan="4"
                                   Height="5"
                                   VerticalAlignment="Top"
                                   Cursor="SizeNS"
                                   Background="Transparent"
                                   Opacity="0"
                                   Margin="-10,-10,-10,0"
                                   DragDelta="AreaNavigatorTopResizeThumb_DragDelta"
                                   DragCompleted="PopupResizeThumb_DragCompleted"/>
                            <Thumb Grid.RowSpan="4"
                                   Width="14"
                                   Height="14"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top"
                                   Cursor="SizeNESW"
                                   Background="Transparent"
                                   Opacity="0"
                                   Margin="0,-10,-10,0"
                                   DragDelta="AreaNavigatorTopRightResizeThumb_DragDelta"
                                   DragCompleted="PopupResizeThumb_DragCompleted"/>
                        </Grid>
                    </Border>
                </Popup>

                <Popup x:Name="MusicListPopup"
                       AutomationProperties.AutomationId="Main.MusicList.Popup"
                       Placement="Top"
                       StaysOpen="False"
                       AllowsTransparency="True">
                    <Border x:Name="MusicListPopupFrame"
                            Background="#FF202020"
                            BorderBrush="#FF3E5362"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10">
                        <Grid x:Name="MusicListPopupSurface"
                              MinWidth="260"
                              MinHeight="300"
                              Width="320"
                              Height="420">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.RowSpan="5" Background="#E6111418"/>
                                <DockPanel x:Name="MusicListTitleRow" Margin="0,0,0,6">
                                    <TextBlock Text="Music List" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Button x:Name="btnRefreshMusicList"
                                            AutomationProperties.AutomationId="Main.MusicList.Refresh"
                                            Content="Refresh"
                                            DockPanel.Dock="Right"
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource PopupCommandButtonStyle}"
                                            Click="btnRefreshMusicList_Click"/>
                                </DockPanel>
                                <TextBox x:Name="txtMusicSearch"
                                         Grid.Row="1"
                                         AutomationProperties.AutomationId="Main.MusicList.Search"
                                         Height="26"
                                         Margin="0,0,0,6"
                                         Padding="7,3"
                                         Background="#FF1C2227"
                                         BorderBrush="#FF3E5362"
                                         Foreground="#FFE8E8E8"
                                         TextChanged="txtMusicSearch_TextChanged"/>
                                <TreeView x:Name="treeMusic"
                                         PreviewMouseRightButtonDown="treeMusic_PreviewMouseRightButtonDown"
                                         Grid.Row="2"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         AutomationProperties.AutomationId="Main.MusicList.List"
                                         Margin="0,0,0,8"
                                         Background="#FF11161A"
                                         BorderBrush="#FF2F434E"
                                         Foreground="#FFE8E8E8"
                                         MouseDoubleClick="treeMusic_MouseDoubleClick"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         ScrollViewer.CanContentScroll="True">
                                    <TreeView.ContextMenu>
                                        <ContextMenu Opened="MusicContextMenu_Opened"/>
                                    </TreeView.ContextMenu>
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="{x:Type TreeViewItem}">
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                            <Setter Property="Foreground" Value="#FFE8E8E8"/>
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                                            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                                            <EventSetter Event="Expanded" Handler="MusicTreeItemExpansionChanged"/>
                                            <EventSetter Event="Collapsed" Handler="MusicTreeItemExpansionChanged"/>
                                            <Style.Resources>
                                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFE8E8E8"/>
                                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFE8E8E8"/>
                                            </Style.Resources>
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                            <Border x:Name="ItemBorder"
                                                    Margin="0,0,0,2"
                                                    Padding="{Binding Padding}"
                                                    Background="{Binding RowBackground}"
                                                    ToolTip="{Binding Tooltip}"
                                                    BorderThickness="3,0,0,0"
                                                    BorderBrush="Transparent">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               Foreground="{Binding TitleBrush}"
                                                               FontWeight="{Binding FontWeight}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding AssetPath}"
                                                               Foreground="#FF8E9CA4"
                                                               FontSize="10"
                                                               Visibility="{Binding AssetPathVisibility}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Border>
                                            <HierarchicalDataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FF4A90D9"/>
                                                </DataTrigger>
                                            </HierarchicalDataTemplate.Triggers>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                                <Border x:Name="MusicListNowPlayingBlock" Grid.Row="3" Background="#FF0F1418" BorderBrush="#FF2D3C44" BorderThickness="1" CornerRadius="4" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="Currently Playing" Foreground="#FF9BC7DF" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock x:Name="txtCurrentMusicTitle"
                                                   AutomationProperties.AutomationId="Main.MusicList.CurrentTitle"
                                                   Text="None"
                                                   Foreground="#FFF2F2F2"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="txtCurrentMusicPath"
                                                   AutomationProperties.AutomationId="Main.MusicList.CurrentPath"
                                                   Text="No active music packet."
                                                   Foreground="#FF89949B"
                                                    FontSize="10"
                                                   Visibility="Collapsed"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="txtCurrentMusicPlaylist"
                                                   AutomationProperties.AutomationId="Main.MusicList.CurrentPlaylist"
                                                   Text="Playlist: Not provided by server"
                                                   Foreground="#FFB4C2C9"
                                                   FontSize="10"
                                                   Margin="0,2,0,6"
                                                   Visibility="Collapsed"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button x:Name="btnStopMusic"
                                                    AutomationProperties.AutomationId="Main.MusicList.Stop"
                                                    Content="Stop"
                                                    Width="82"
                                                    Style="{StaticResource PopupCommandButtonStyle}"
                                                    Click="btnStopMusic_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Thumb Grid.RowSpan="5"
                                       Width="5"
                                       HorizontalAlignment="Right"
                                       Cursor="SizeWE"
                                       Background="Transparent"
                                       Opacity="0"
                                       Margin="0,-10,-10,-10"
                                       DragDelta="MusicListRightResizeThumb_DragDelta"
                                       DragCompleted="PopupResizeThumb_DragCompleted"/>
                                <Thumb Grid.RowSpan="5"
                                       Height="5"
                                       VerticalAlignment="Top"
                                       Cursor="SizeNS"
                                       Background="Transparent"
                                       Opacity="0"
                                       Margin="-10,-10,-10,0"
                                       DragDelta="MusicListTopResizeThumb_DragDelta"
                                       DragCompleted="PopupResizeThumb_DragCompleted"/>
                                <Thumb Grid.RowSpan="5"
                                       Width="14"
                                       Height="14"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       Cursor="SizeNESW"
                                       Background="Transparent"
                                       Opacity="0"
                                       Margin="0,-10,-10,0"
                                       DragDelta="MusicListTopRightResizeThumb_DragDelta"
                                       DragCompleted="PopupResizeThumb_DragCompleted"/>
                        </Grid>
                    </Border>
                </Popup>
                <Button x:Name="THEDINGBUTTON"
                    BorderBrush="{x:Null}" Foreground="{x:Null}" Padding="0"
                    Click="THEDINGBUTTON_Click" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Grid>
                                            <Rectangle x:Name="ButtonImage" Stretch="Fill" Fill="#FF36393F">
                                                <Rectangle.OpacityMask>
                                                    <ImageBrush ImageSource="pack://application:,,,/OceanyaClient;component/Resources/Buttons/Ding.png"/>
                                                </Rectangle.OpacityMask>
                                            </Rectangle>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ButtonImage" Property="Opacity" Value="0.7"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="ButtonImage" Property="Opacity" Value="0.3"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Canvas>
        </Grid>
    </Border>
</local:OceanyaWindowContentControl>
