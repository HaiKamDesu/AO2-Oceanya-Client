<!--
    AO2's own default control chrome.

    AO2 is a Qt app running the native Windows style, so any widget its theme does NOT skin is drawn as a
    plain platform control: a light grey push button with a thin border and its text label, and a stock
    track-bar slider. `AOButton::setImage` makes this explicit - with no art it calls setStyleSheet(QString())
    and setIcon(QIcon()), dropping straight back to the platform look.

    Oceanya's own buttons and sliders look nothing like that, so a theme that simply leaves "Settings",
    "Change character", "Reload theme", "Call mod" or the volume sliders un-skinned used to render in
    Oceanya styling and break the theme's look. These styles are what such panels wear instead. Colours are
    the Windows/Qt Fusion defaults, not invented.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Windows push button: idle / hover / pressed / disabled -->
    <LinearGradientBrush x:Key="Ao2ButtonFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F0F0F0"/>
        <GradientStop Offset="1" Color="#E1E1E1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Ao2ButtonFaceHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#ECF4FC"/>
        <GradientStop Offset="1" Color="#DCECFC"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Ao2ButtonFacePressed" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#DAECFC"/>
        <GradientStop Offset="1" Color="#C4E0FC"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Ao2ButtonBorder" Color="#ADADAD"/>
    <SolidColorBrush x:Key="Ao2ButtonBorderHover" Color="#7EB4EA"/>
    <SolidColorBrush x:Key="Ao2ButtonBorderPressed" Color="#569DE5"/>
    <SolidColorBrush x:Key="Ao2ButtonText" Color="#000000"/>
    <SolidColorBrush x:Key="Ao2ButtonTextDisabled" Color="#838383"/>
    <SolidColorBrush x:Key="Ao2ButtonFaceDisabled" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="Ao2ButtonBorderDisabled" Color="#BFBFBF"/>

    <ControlTemplate x:Key="Ao2DefaultButtonTemplate" TargetType="{x:Type ButtonBase}">
        <Border x:Name="Face"
                Background="{StaticResource Ao2ButtonFace}"
                BorderBrush="{StaticResource Ao2ButtonBorder}"
                BorderThickness="1"
                SnapsToDevicePixels="True">
            <ContentPresenter x:Name="Content"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"
                              RecognizesAccessKey="True"
                              SnapsToDevicePixels="True"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{StaticResource Ao2ButtonFaceHover}"/>
                <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Ao2ButtonBorderHover}"/>
            </Trigger>
            <Trigger Property="ButtonBase.IsPressed" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{StaticResource Ao2ButtonFacePressed}"/>
                <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Ao2ButtonBorderPressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Face" Property="Background" Value="{StaticResource Ao2ButtonFaceDisabled}"/>
                <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Ao2ButtonBorderDisabled}"/>
                <Setter Property="Foreground" Value="{StaticResource Ao2ButtonTextDisabled}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Ao2DefaultButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{StaticResource Ao2ButtonText}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Padding" Value="4,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template" Value="{StaticResource Ao2DefaultButtonTemplate}"/>
    </Style>

    <!-- The same face, for the panels that are toggles rather than plain buttons. -->
    <Style x:Key="Ao2DefaultToggleButtonStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Foreground" Value="{StaticResource Ao2ButtonText}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="4,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template" Value="{StaticResource Ao2DefaultButtonTemplate}"/>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource Ao2ButtonFacePressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Windows check box. Sampled from an AO2 capture: a white box with a mid-grey border and a black
        tick, with the label beside it in the theme's own text colour. Ours drew no box at all, so a
        theme's checkboxes read as bare words.
    -->
    <SolidColorBrush x:Key="Ao2CheckBoxFill" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Ao2CheckBoxBorder" Color="#333333"/>
    <SolidColorBrush x:Key="Ao2CheckBoxCheckedFill" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Ao2CheckBoxCheckedBorder" Color="#333333"/>

    <Style x:Key="Ao2DefaultCheckBoxStyle" TargetType="{x:Type CheckBox}">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <StackPanel Orientation="Horizontal" Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="PART_Ao2CheckBoxIndicator"
                                Width="13"
                                Height="13"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Ao2CheckBoxFill}"
                                BorderBrush="{DynamicResource Ao2CheckBoxBorder}"
                                BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <Path x:Name="Tick"
                                  Visibility="Collapsed"
                                  Stretch="Uniform"
                                  Margin="2"
                                  Stroke="#000000"
                                  StrokeThickness="1.6"
                                  StrokeEndLineCap="Square"
                                  StrokeStartLineCap="Square"
                                  Data="M 0,4 L 3,7 L 9,0"/>
                        </Border>
                        <ContentPresenter Margin="5,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          SnapsToDevicePixels="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_Ao2CheckBoxIndicator" Property="Background" Value="{DynamicResource Ao2CheckBoxCheckedFill}"/>
                            <Setter TargetName="PART_Ao2CheckBoxIndicator" Property="BorderBrush" Value="{DynamicResource Ao2CheckBoxCheckedBorder}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Tick" Property="Opacity" Value="0.5"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Ao2CheckBoxIndicator" Property="BorderBrush" Value="#0078D7"/>
                            <Setter TargetName="PART_Ao2CheckBoxIndicator" Property="Background" Value="#F3F9FF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Ao2CheckBoxIndicator" Property="Background" Value="#E6E6E6"/>
                            <Setter TargetName="PART_Ao2CheckBoxIndicator" Property="BorderBrush" Value="#BFBFBF"/>
                            <Setter TargetName="Tick" Property="Stroke" Value="#838383"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Windows track bar: a thin sunken groove with a small flat handle. -->
    <Style x:Key="Ao2DefaultSliderStyle" TargetType="{x:Type Slider}">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="MinHeight" Value="18"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid SnapsToDevicePixels="True">
                        <Border VerticalAlignment="Center"
                                Height="4"
                                Background="#E7EAEA"
                                BorderBrush="#D6D6D6"
                                BorderThickness="1"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge"
                                              Focusable="False"
                                              Opacity="0"
                                              Background="Transparent"
                                              BorderThickness="0"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge"
                                              Focusable="False"
                                              Opacity="0"
                                              Background="Transparent"
                                              BorderThickness="0"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <!--
                                    Handle colour and groove colours are sampled from an AO2 capture, not
                                    guessed: the groove is #E7EAEA on a #D6D6D6 frame and the handle is the
                                    Windows accent #007AD9, drawn flat and filling the slider's height.
                                -->
                                <Thumb x:Name="Handle" Width="11" VerticalAlignment="Stretch" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border x:Name="HandleFace"
                                                    Background="#007AD9"
                                                    SnapsToDevicePixels="True"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HandleFace" Property="Background" Value="#2A96E8"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="HandleFace" Property="Background" Value="#0061B0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
