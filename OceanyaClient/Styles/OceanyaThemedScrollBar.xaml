<!--
    Scrollbar look a theme can drive. AO2 themes style QScrollBar (track, handle and border colours), so
    the panel styling applier puts this style plus three colour brushes into a panel's own Resources when
    those colours are set, and removes them again on reset. Everything reads DynamicResource so one style
    instance serves every panel with its own colours.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Horizontal bars use the same parts, laid out along the other axis. -->
    <ControlTemplate x:Key="OceanyaThemedHorizontalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="0,1,0,0">
            <Track x:Name="PART_Track"
                   Orientation="Horizontal"
                   ViewportSize="{TemplateBinding ScrollBar.ViewportSize}">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Focusable="False" Opacity="0">
                        <RepeatButton.Template>
                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                <Border Background="Transparent"/>
                            </ControlTemplate>
                        </RepeatButton.Template>
                    </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb MinWidth="15">
                        <Thumb.Template>
                            <ControlTemplate TargetType="{x:Type Thumb}">
                                <Border Background="{DynamicResource OceanyaScrollBarHandleBrush}"
                                        BorderBrush="{DynamicResource OceanyaScrollBarBorderBrush}"
                                        BorderThickness="1,0,1,0"/>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Focusable="False" Opacity="0">
                        <RepeatButton.Template>
                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                <Border Background="Transparent"/>
                            </ControlTemplate>
                        </RepeatButton.Template>
                    </RepeatButton>
                </Track.IncreaseRepeatButton>
            </Track>
        </Border>
    </ControlTemplate>

    <Style x:Key="OceanyaThemedScrollBarStyle" TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="{DynamicResource OceanyaScrollBarTrackBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OceanyaScrollBarBorderBrush}"/>
        <Setter Property="Width" Value="15"/>
        <Setter Property="MinWidth" Value="15"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="15"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="15"/>
                            </Grid.RowDefinitions>

                            <RepeatButton Grid.Row="0"
                                          Command="ScrollBar.LineUpCommand"
                                          Focusable="False"
                                          Background="{DynamicResource OceanyaScrollBarHandleBrush}"
                                          BorderBrush="{TemplateBinding BorderBrush}">
                                <RepeatButton.Template>
                                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="0,0,0,1">
                                            <Path Data="M 0 5 L 8 5 L 4 0 Z"
                                                  Fill="{DynamicResource OceanyaScrollBarBorderBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>

                            <!--
                                ViewportSize is NOT resolved automatically: without it the Track cannot work
                                out how big the thumb should be, so the scrollbar renders with no visible
                                handle at all - which reads as "this list has no scrollbar".
                            -->
                            <Track Grid.Row="1"
                                   x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   ViewportSize="{TemplateBinding ScrollBar.ViewportSize}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="15">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="{DynamicResource OceanyaScrollBarHandleBrush}"
                                                        BorderBrush="{DynamicResource OceanyaScrollBarBorderBrush}"
                                                        BorderThickness="0,1,0,1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>

                            <RepeatButton Grid.Row="2"
                                          Command="ScrollBar.LineDownCommand"
                                          Focusable="False"
                                          Background="{DynamicResource OceanyaScrollBarHandleBrush}"
                                          BorderBrush="{TemplateBinding BorderBrush}">
                                <RepeatButton.Template>
                                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="0,1,0,0">
                                            <Path Data="M 0 0 L 8 0 L 4 5 Z"
                                                  Fill="{DynamicResource OceanyaScrollBarBorderBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="15"/>
                <Setter Property="MinHeight" Value="15"/>
                <Setter Property="Template" Value="{StaticResource OceanyaThemedHorizontalScrollBarTemplate}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
