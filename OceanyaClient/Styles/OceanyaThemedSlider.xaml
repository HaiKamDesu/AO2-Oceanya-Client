<!--
    Slider look a theme can drive. AO2 skins QSlider through its stylesheet, in four parts:
      ::groove    widget-wide background art (GrayGarden's `sliders/meter.png`, 168x30 - the tick marks)
      ::sub-page  the FILLED part, left of the handle (GrayGarden: solid white, 5px tall, centred)
      ::add-page  the empty part, right of the handle (GrayGarden: transparent with a border)
      ::handle    a small image on top (`sliders/handle.png`)
    The applier puts this template plus its brushes into a slider panel's own Resources, and removes them
    again on reset. Without the two pages the slider showed only the tick art and the handle - no fill.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="OceanyaThemedSliderStyle" TargetType="{x:Type Slider}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid Background="{DynamicResource OceanyaSliderGrooveBrush}">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                            <!-- The filled side. Its height and centring mirror Qt's margins. -->
                                            <Border Background="{DynamicResource OceanyaSliderFillBrush}"
                                                    BorderBrush="{DynamicResource OceanyaSliderPageBorderBrush}"
                                                    BorderThickness="1"
                                                    Height="{DynamicResource OceanyaSliderPageHeight}"
                                                    VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="PART_Thumb" Width="{DynamicResource OceanyaSliderHandleWidth}">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Grid Background="{DynamicResource OceanyaSliderHandleBrush}"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                            <!-- The empty side. -->
                                            <Border Background="{DynamicResource OceanyaSliderEmptyBrush}"
                                                    BorderBrush="{DynamicResource OceanyaSliderPageBorderBrush}"
                                                    BorderThickness="1"
                                                    Height="{DynamicResource OceanyaSliderPageHeight}"
                                                    VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
