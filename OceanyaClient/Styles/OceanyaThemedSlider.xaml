<!--
    Slider look a theme can drive. AO2 skins QSlider through its stylesheet, in four parts:
      ::groove    widget-wide background art (GrayGarden's `sliders/meter.png`, 168x30 - the tick marks)
      ::add-page  the empty part, right of the handle (GrayGarden: transparent with a 1px border)
      ::sub-page  the FILLED part, left of the handle (GrayGarden: solid white, 5px tall, centred)
      ::handle    a small image on top (`sliders/handle.png`)

    Qt draws add-page and sub-page as two halves of one bar, which reads as a single bordered rectangle
    with a filled left side. So the track is drawn ONCE here, full width, and the fill sits inside it -
    bordering each half separately left a seam at the handle. The fill also runs half a handle past the
    thumb's edge, so it reaches the middle of the handle art instead of stopping short of it.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="OceanyaThemedSliderStyle" TargetType="{x:Type Slider}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid Background="{DynamicResource OceanyaSliderGrooveBrush}">
                        <!-- The whole track: one continuous rectangle, empty colour plus its border. -->
                        <Border Background="{DynamicResource OceanyaSliderEmptyBrush}"
                                BorderBrush="{DynamicResource OceanyaSliderPageBorderBrush}"
                                BorderThickness="1"
                                Height="{DynamicResource OceanyaSliderPageHeight}"
                                VerticalAlignment="Center"/>

                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                            <Border Background="{DynamicResource OceanyaSliderFillBrush}"
                                                    Height="{DynamicResource OceanyaSliderFillHeight}"
                                                    Margin="{DynamicResource OceanyaSliderFillMargin}"
                                                    VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="PART_Thumb" Width="{DynamicResource OceanyaSliderHandleWidth}">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Grid Background="{DynamicResource OceanyaSliderHandleBrush}"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
